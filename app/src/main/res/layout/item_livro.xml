<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!--IMAGEM DA CAPA  -->
        <ImageView
            android:id="@+id/imgCapa"
            android:layout_width="60dp"
            android:layout_height="90dp"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/book_cover" />

        <!--  ESTRELA FAVORITO lado dirito -->
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignTop="@id/imgCapa"
            android:layout_alignEnd="@id/imgCapa"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="-6dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/star_big_off"
            android:contentDescription="@string/add_to_favorites"
            android:padding="2dp"
            android:elevation="4dp" />

        <!-- INFORMAÇÕES  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/imgCapa"
            android:orientation="vertical">

            <!-- Título -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Autores -->
            <TextView
                android:id="@+id/txtAutores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_author"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:textColor="#666666"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Categoria -->
            <TextView
                android:id="@+id/txtCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_category"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:textColor="#999999"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Editora -->
            <TextView
                android:id="@+id/txtEditora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_publisher"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textColor="#999999"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- ISbn -->
            <TextView
                android:id="@+id/txtISBN"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Descrição  -->
            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <!-- Disponibilidade -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtDisponibilidade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/available_count"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/book_available"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"
                    android:padding="4dp" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>

